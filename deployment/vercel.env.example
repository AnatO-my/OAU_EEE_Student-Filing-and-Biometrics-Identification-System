# Enter real values privately in Vercel project settings; never commit them.
DJANGO_SETTINGS_MODULE=config.vercel_settings
DJANGO_SECRET_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_PROJECT.vercel.app
DEMO_PUBLIC_ORIGIN=https://REPLACE_WITH_PROJECT.vercel.app
DEMO_SYNTHETIC_ONLY=true
POSTGRES_HOST=REPLACE_WITH_AIVEN_HOST
POSTGRES_PORT=REPLACE_WITH_AIVEN_PORT
POSTGRES_DB=eee_demo_20261029
POSTGRES_USER=REPLACE_WITH_DEDICATED_DEMO_ROLE
POSTGRES_PASSWORD=REPLACE_PRIVATELY
POSTGRES_SSLMODE=verify-full
# Paste the actual multiline service CA into this environment variable.
AIVEN_CA_PEM=REPLACE_PRIVATELY_WITH_MULTILINE_CA_CERTIFICATE
DEMO_EMAIL_ENABLED=false
RESULT_SHARING_ENABLED=false
