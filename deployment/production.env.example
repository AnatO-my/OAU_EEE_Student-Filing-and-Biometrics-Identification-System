# TEMPLATE ONLY. Configure privately on the approved host/provider.
# The same Django secret/database must be used by API and worker.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_PRIVATELY
DJANGO_ALLOWED_HOSTS=portal.example.invalid,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.invalid
DJANGO_SECURE_TRANSPORT=true
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SECURE_HSTS_SECONDS=3600
PASSWORD_RESET_FRONTEND_URL=https://portal.example.invalid/reset-password
POSTGRES_DB=defaultdb
POSTGRES_USER=avnadmin
POSTGRES_HOST=REPLACE_WITH_AIVEN_HOST
POSTGRES_PORT=14172
POSTGRES_PASSWORD=REPLACE_PRIVATELY
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/run/secrets/aiven_ca
POSTGRES_CONNECT_TIMEOUT=10
PSYCOPG_IMPL=python
# Set provider credentials privately only at the supervised delivery gate.
# Production rejects fake mail backends. Keep sharing off and the worker stopped
# until the provider and controlled-recipient test are explicitly configured.
DJANGO_EMAIL_BACKEND=academics.email_backend.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_AUTH_METHOD=LOGIN
DJANGO_EMAIL_HOST_USER=REPLACE_PRIVATELY
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_PRIVATELY
DJANGO_DEFAULT_FROM_EMAIL=REPLACE_PRIVATELY
RESULT_SHARING_ENABLED=false
