# Django does not automatically load this file.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin of the React development server, comma separated, needed for csrf.
# Example: http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
# Opt in with --settings=config.postgres_settings; defaults remain SQLite.
# Use a new, dedicated database initially, not the existing portal database.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
# verify-full for remote connections; disable only for trusted local development.
POSTGRES_SSLMODE=verify-full
# Never commit credentials. Configure the trusted root certificate for remote TLS.

# Required for ordinary staff adviser scope; set the institution's current session.
CURRENT_ACADEMIC_SESSION=

# Production transport hardening. Enable only where HTTPS terminates; keep it
# disabled on plain-HTTP development servers or every request will redirect.
DJANGO_SECURE_TRANSPORT=false
# Optional overrides, defaults shown. HSTS defaults to one year when transport
# hardening is enabled and to zero otherwise.
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Staff sessions expire after this many seconds (default 43200 = 12 hours).
# DJANGO_SESSION_COOKIE_AGE_SECONDS=43200

# Frontend page that receives uid/token and posts to /api/auth/password/reset/confirm/.
# Use HTTPS outside development. Leave empty to keep reset requests disabled.
PASSWORD_RESET_FRONTEND_URL=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.invalid

# Guardian semester report sharing. Disabled until email/WhatsApp are configured.
RESULT_SHARING_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Explicit supported Graph API version, e.g. vXX.X; verify with your Meta account.
WHATSAPP_API_VERSION=
# Approved template with exactly one body text parameter for the compact report.
WHATSAPP_RESULT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
