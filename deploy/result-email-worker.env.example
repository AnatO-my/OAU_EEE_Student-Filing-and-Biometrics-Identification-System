# TEMPLATE ONLY. Supply actual values privately on the deployment host.
# The API and worker must use the same database and provider settings.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_THE_DEPLOYMENT_SECRET
POSTGRES_DB=REPLACE_WITH_DATABASE
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_HOST=REPLACE_WITH_DATABASE_HOST
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
# Supply your PostgreSQL CA file at an administrator-controlled readable path.
PGSSLROOTCERT=/etc/eee/postgres-root.crt
DJANGO_EMAIL_BACKEND=academics.email_backend.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_AUTH_METHOD=LOGIN
DJANGO_EMAIL_HOST_USER=REPLACE_WITH_SENDING_GOOGLE_ACCOUNT
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
DJANGO_DEFAULT_FROM_EMAIL=REPLACE_WITH_SENDING_GOOGLE_ACCOUNT
RESULT_SHARING_ENABLED=true
